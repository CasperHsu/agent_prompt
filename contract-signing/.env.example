# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contract_signing

# Application
APP_URL=http://localhost:3000
APP_NAME="Vision Eco 合約簽署"

# Admin (placeholder until CRM integration)
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# Email (Resend, optional in dev)
RESEND_API_KEY=
EMAIL_FROM="Vision Eco <contracts@example.com>"

# SMS (Twilio / 三竹簡訊, optional in dev)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# TWCA Timestamp (Phase 2)
TWCA_TSA_URL=
TWCA_TSA_USERNAME=
TWCA_TSA_PASSWORD=

# Storage (signed PDFs, signature images). Local filesystem in dev.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
