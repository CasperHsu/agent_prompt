# Database (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contract_signing

# Application
APP_URL=http://localhost:3000
APP_NAME="Vision Eco 合約簽署"

# Admin (placeholder until CRM integration)
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# Email (Resend, optional in dev)
RESEND_API_KEY=
EMAIL_FROM="Vision Eco <contracts@example.com>"

# SMS (Twilio / 三竹簡訊, optional in dev)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# TWCA Timestamp (Phase 2)
# Leave TWCA_TSA_URL blank to use the dev-stub provider (no legal effect).
# For production, request a TWCA TSA account and fill in the URL + auth.
TWCA_TSA_URL=
TWCA_TSA_USERNAME=
TWCA_TSA_PASSWORD=
# Optional: TWCA-issued policy OID, if required by your contract
TWCA_TSA_POLICY_OID=

# PDF font (override if you ship your own TTF/OTF instead of bundled NotoSansTC)
CONTRACT_PDF_FONT_PATH=

# Storage (signed PDFs, signature images). Local filesystem in dev.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
