# ── LINE Messaging API ──
# 從 LINE Developers Console → 你的 Channel → Messaging API 取得
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# ── 伺服器 ──
PORT=3000

# ── AI 回覆（選用）──
# 留空則停用 AI 回覆，FAQ 未命中時一律轉真人。
# 啟用後，FAQ 未命中且非紅線的問題，會用知識庫 + 品牌語氣產生回覆。
ANTHROPIC_API_KEY=
# 客服建議用快速、低成本的模型；可依需要調整
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── 客服營運 ──
# 服務時間（24 小時制，伺服器時區），非服務時間自動回覆告知
SERVICE_HOURS_START=10
SERVICE_HOURS_END=18
# 服務日（0=週日 ... 6=週六），逗號分隔
SERVICE_DAYS=1,2,3,4,5
# 真人客服 / 主管通知用的 LINE userId 或群組 id（選用）
ESCALATION_NOTIFY_TO=

# ── 連結（回覆話術中的佔位連結）──
COURSE_PAGE_URL=https://example.com/courses
SIGNUP_URL=https://example.com/signup
